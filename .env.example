# Copy to .env.local for common local overrides, or .env.uat.local / .env.production.local.
# Mode files supply VITE_APP_ENV and VITE_APP_NAME; do not override VITE_APP_ENV here.
# Public VITE_ values are included in the client build and require a rebuild to change.
# An empty API URL keeps the template in demo mode. A URL is an integration setting;
# it does not replace the current browser demo data adapter automatically.
# VITE_API_BASE_URL=https://api.example.com/v1

# Server-only secret: required for UAT/PROD and for every built application with demo login.
# Use at least 32 cryptographically random characters. Never prefix with VITE_.
# Deployed servers must receive this from the deployment platform environment.
SESSION_SECRET=

# Local UAT/PROD demo opt-in only: put in that mode's .local file and use HTTPS.
# DEMO_AUTH_ENABLED=true

