{
  "version": "0.0.1",
  "name": "void-dashboard",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --mode development --port 3000",
    "dev:dev": "vite dev --mode development --port 3000",
    "dev:uat": "vite dev --mode uat --port 3000",
    "dev:prod": "vite dev --mode production --port 3000",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "build:uat": "vite build --mode uat",
    "build:prod": "vite build --mode production",
    "preview": "vite preview --mode production",
    "preview:dev": "vite preview --mode development",
    "preview:uat": "vite preview --mode uat",
    "preview:prod": "vite preview --mode production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-core": "1.171.34",
    "@tanstack/router-plugin": "1.168.42",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "pnpm": ">=12.4.1"
  }
}
